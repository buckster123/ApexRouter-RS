// OWNER: unit U-02. The input primitives.
//
// These are hand-rolled rather than taken from `std-widgets` for one reason: every pixel
// has to come from `Palette`, and a themed widget set brings its own colours. The set is
// deliberately small — button, field, multi-line area, toggle, chooser, stepper.

import { Palette } from "../palette.slint";

// kind: 0 = default · 1 = primary · 2 = danger (destroy / spend) · 3 = ghost
export component Btn inherits Rectangle {
    in property <string> label;
    in property <int> kind: 0;
    in property <bool> enabled: true;
    in property <string> icon;
    in property <bool> compact: false;
    callback clicked();

    height: root.compact ? 22px : Palette.ctl-h;
    horizontal-stretch: 0;
    min-width: txt.preferred-width + (root.compact ? 14px : 22px);
    border-radius: Palette.radius-sm;
    border-width: root.kind == 3 ? 0px : Palette.hair;
    border-color: root.kind == 1 ? Palette.accent
        : root.kind == 2 ? Palette.critical
        : Palette.hairline;
    background: !root.enabled ? Palette.surface-lo
        : root.kind == 1 ? (ta.has-hover ? Palette.accent : Palette.accent-dim)
        : root.kind == 2 ? (ta.has-hover ? Palette.critical : Palette.critical-dim)
        : root.kind == 3 ? (ta.has-hover ? Palette.surface-hi : Palette.clear)
        : (ta.has-hover ? Palette.surface-hi : Palette.surface);

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: root.compact ? 7px : 11px;
        padding-right: root.compact ? 7px : 11px;
        spacing: 5px;
        alignment: center;
        if root.icon != "": Text {
            text: root.icon;
            font-size: Palette.font-sm;
            vertical-alignment: center;
            color: !root.enabled ? Palette.muted
                : root.kind == 1 ? (ta.has-hover ? Palette.on-accent : Palette.accent)
                : root.kind == 2 ? (ta.has-hover ? Palette.on-accent : Palette.critical)
                : Palette.ink-2;
        }
        txt := Text {
            text: root.label;
            font-size: root.compact ? Palette.font-sm : Palette.font;
            vertical-alignment: center;
            color: !root.enabled ? Palette.muted
                : root.kind == 1 ? (ta.has-hover ? Palette.on-accent : Palette.accent)
                : root.kind == 2 ? (ta.has-hover ? Palette.on-accent : Palette.critical)
                : Palette.ink-2;
        }
    }
}

// A single-line text field. `password: true` masks the value — the Providers screen never
// renders a key in the clear, and never learns one it was not given (§9.2).
export component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> value;
    in property <bool> password: false;
    in property <bool> mono: false;
    in property <bool> read-only: false;
    in property <bool> enabled: true;
    callback edited(string);
    callback accepted(string);

    height: Palette.ctl-h;
    background: root.enabled ? Palette.surface-hi : Palette.surface-lo;
    border-radius: Palette.radius-sm;
    border-width: Palette.hair;
    border-color: ti.has-focus ? Palette.accent : Palette.hairline;

    HorizontalLayout {
        padding-left: Palette.pad-sm;
        padding-right: Palette.pad-sm;
        ti := TextInput {
            text <=> root.value;
            color: root.enabled ? Palette.ink : Palette.muted;
            selection-background-color: Palette.accent-dim;
            selection-foreground-color: Palette.ink;
            font-size: Palette.font;
            font-family: root.mono ? Palette.mono : Palette.sans;
            input-type: root.password ? InputType.password : InputType.text;
            read-only: root.read-only;
            enabled: root.enabled;
            single-line: true;
            vertical-alignment: center;
            edited => {
                root.edited(self.text);
            }
            accepted => {
                root.accepted(self.text);
            }
        }
    }

    Text {
        x: Palette.pad-sm;
        visible: root.value == "" && !ti.has-focus;
        text: root.placeholder;
        color: Palette.muted;
        font-size: Palette.font;
        vertical-alignment: center;
    }

    // The Router bar's copy button: select the whole value and put it on the clipboard.
    public function copy-all() {
        ti.select-all();
        ti.copy();
        ti.clear-selection();
    }
    public function focus-field() {
        ti.focus();
    }
}

// Multi-line. Used for the recipe body, `onstart`, and extra-args.
export component Area inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> value;
    in property <bool> mono: true;
    in property <bool> read-only: false;
    callback edited(string);

    background: Palette.surface-hi;
    border-radius: Palette.radius-sm;
    border-width: Palette.hair;
    border-color: ti.has-focus ? Palette.accent : Palette.hairline;
    clip: true;

    Flickable {
        x: Palette.pad-sm;
        y: 4px;
        width: parent.width - 2 * Palette.pad-sm;
        height: parent.height - 8px;
        viewport-width: self.width;
        viewport-height: max(self.height, ti.preferred-height);
        ti := TextInput {
            width: parent.width;
            text <=> root.value;
            color: Palette.ink;
            selection-background-color: Palette.accent-dim;
            selection-foreground-color: Palette.ink;
            font-size: Palette.font-sm;
            font-family: root.mono ? Palette.mono : Palette.sans;
            read-only: root.read-only;
            single-line: false;
            wrap: word-wrap;
            edited => {
                root.edited(self.text);
            }
        }
    }

    Text {
        x: Palette.pad-sm;
        y: 4px;
        visible: root.value == "" && !ti.has-focus;
        text: root.placeholder;
        color: Palette.muted;
        font-size: Palette.font-sm;
    }
}

export component Toggle inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);
    spacing: Palette.gap;
    height: Palette.ctl-h;

    Rectangle {
        width: 16px;
        height: 16px;
        y: (parent.height - 16px) / 2;
        border-radius: 3px;
        border-width: Palette.hair;
        border-color: root.checked ? Palette.accent : Palette.hairline;
        background: root.checked ? Palette.accent-dim : Palette.surface-hi;
        Text {
            text: root.checked ? "✓" : "";
            color: Palette.accent;
            font-size: Palette.font-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.label != "": Text {
        text: root.label;
        color: root.enabled ? Palette.ink-2 : Palette.muted;
        font-size: Palette.font-sm;
        vertical-alignment: center;
    }
    Rectangle { }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// A dropdown over a list of strings.
export component Chooser inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current: 0;
    in property <string> placeholder: "—";
    in property <bool> enabled: true;
    callback changed(int);

    height: Palette.ctl-h;
    background: root.enabled ? Palette.surface-hi : Palette.surface-lo;
    border-radius: Palette.radius-sm;
    border-width: Palette.hair;
    border-color: Palette.hairline;

    HorizontalLayout {
        padding-left: Palette.pad-sm;
        padding-right: Palette.pad-sm;
        spacing: 4px;
        Text {
            text: root.current >= 0 && root.current < root.options.length
                ? root.options[root.current] : root.placeholder;
            color: root.enabled ? Palette.ink : Palette.muted;
            font-size: Palette.font;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { }
        Text {
            text: "▾";
            color: Palette.muted;
            font-size: Palette.font-sm;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            pop.show();
        }
    }

    pop := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        height: min(240px, root.options.length * 24px + 8px);
        Rectangle {
            background: Palette.surface;
            border-width: Palette.hair;
            border-color: Palette.hairline;
            border-radius: Palette.radius-sm;
            Flickable {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                viewport-width: self.width;
                viewport-height: max(self.height, root.options.length * 24px);
                for opt[i] in root.options: Rectangle {
                    y: i * 24px;
                    width: parent.width;
                    height: 24px;
                    border-radius: Palette.radius-sm;
                    background: ita.has-hover ? Palette.surface-hi : Palette.clear;
                    ita := TouchArea {
                        clicked => {
                            root.current = i;
                            root.changed(i);
                            pop.close();
                        }
                    }
                    Text {
                        x: Palette.pad-sm;
                        text: opt;
                        color: i == root.current ? Palette.accent : Palette.ink-2;
                        font-size: Palette.font-sm;
                        vertical-alignment: center;
                        height: parent.height;
                        overflow: elide;
                        width: parent.width - 2 * Palette.pad-sm;
                    }
                }
            }
        }
    }
}

// An integer stepper. `step` is multiplicative for context lengths, additive otherwise.
export component Stepper inherits HorizontalLayout {
    in-out property <int> value: 0;
    in property <int> step: 1;
    in property <int> minimum: 0;
    in property <int> maximum: 2147483647;
    in property <bool> multiply: false;
    callback changed(int);
    spacing: 4px;
    height: Palette.ctl-h;

    Btn {
        label: "−";
        compact: true;
        width: 24px;
        clicked => {
            root.value = max(root.minimum, root.multiply
                ? (root.value / 2 >= root.minimum ? root.value / 2 : root.minimum)
                : root.value - root.step);
            root.changed(root.value);
        }
    }
    Rectangle {
        background: Palette.surface-hi;
        border-radius: Palette.radius-sm;
        border-width: Palette.hair;
        border-color: ti.has-focus ? Palette.accent : Palette.hairline;
        min-width: 72px;
        ti := TextInput {
            text: root.value;
            color: Palette.ink;
            selection-background-color: Palette.accent-dim;
            font-size: Palette.font;
            font-family: Palette.mono;
            input-type: InputType.number;
            single-line: true;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
            accepted => {
                root.value = clamp(self.text.to-float(), root.minimum, root.maximum);
                root.changed(root.value);
            }
        }
    }
    Btn {
        label: "+";
        compact: true;
        width: 24px;
        clicked => {
            root.value = min(root.maximum, root.multiply
                ? (root.value <= 0 ? root.step : root.value * 2)
                : root.value + root.step);
            root.changed(root.value);
        }
    }
}

// A labelled control, so forms line up without every screen repeating the layout.
export component Labeled inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 3px;
    Text {
        text: root.label;
        color: Palette.muted;
        font-size: Palette.font-sm;
    }
    @children
    if root.hint != "": Text {
        text: root.hint;
        color: Palette.muted;
        font-size: Palette.font-sm;
        wrap: word-wrap;
    }
}
